diff --git a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
--- a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
+++ b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
@@ -205,7 +206,19 @@ struct snps_hdmirx_dev {
 	u32 edid_blocks_written;
 	u32 cur_fmt_fourcc;
 	u32 color_depth;
-	spinlock_t rst_lock; /* to lock register access */
+	/*
+	 * RAW, and it has to be. Every MMIO access in this driver funnels
+	 * through the four accessors below, and TWO of this device's three
+	 * interrupts reach them from hardirq: "hdmi" is requested with no
+	 * threaded half at all, and "cec" reads and acks its own status in
+	 * the primary handler. A spinlock_t is LD_WAIT_CONFIG -- a sleeping
+	 * rt_mutex under PREEMPT_RT -- and hardirq context (LD_WAIT_SPIN)
+	 * may not wait on one, which is what CONFIG_PROVE_RAW_LOCK_NESTING
+	 * reports. Raw is honest here rather than merely convenient: this
+	 * is a leaf that wraps readl()/writel() and one
+	 * reset_control_reset(), and none of those sleep.
+	 */
+	raw_spinlock_t rst_lock; /* to lock register access */
 	u8 edid[EDID_NUM_BLOCKS_MAX * EDID_BLOCK_SIZE];
 };
 
@@ -226,21 +239,21 @@ static const struct v4l2_dv_timings_cap hdmirx_timings_cap = {
 
 static void hdmirx_writel(struct snps_hdmirx_dev *hdmirx_dev, int reg, u32 val)
 {
-	guard(spinlock_irqsave)(&hdmirx_dev->rst_lock);
+	guard(raw_spinlock_irqsave)(&hdmirx_dev->rst_lock);
 
 	writel(val, hdmirx_dev->regs + reg);
 }
 
 static u32 hdmirx_readl(struct snps_hdmirx_dev *hdmirx_dev, int reg)
 {
-	guard(spinlock_irqsave)(&hdmirx_dev->rst_lock);
+	guard(raw_spinlock_irqsave)(&hdmirx_dev->rst_lock);
 
 	return readl(hdmirx_dev->regs + reg);
 }
 
 static void hdmirx_reset_dma(struct snps_hdmirx_dev *hdmirx_dev)
 {
-	guard(spinlock_irqsave)(&hdmirx_dev->rst_lock);
+	guard(raw_spinlock_irqsave)(&hdmirx_dev->rst_lock);
 
 	reset_control_reset(hdmirx_dev->resets[0].rstc);
 }
@@ -250,7 +263,7 @@ static void hdmirx_update_bits(struct snps_hdmirx_dev *hdmirx_dev, int reg,
 {
 	u32 val;
 
-	guard(spinlock_irqsave)(&hdmirx_dev->rst_lock);
+	guard(raw_spinlock_irqsave)(&hdmirx_dev->rst_lock);
 
 	val = readl(hdmirx_dev->regs + reg) & ~mask;
 	val |= (data & mask);
@@ -3333,7 +3346,7 @@ static int hdmirx_probe(struct platform_device *pdev)
 	mutex_init(&hdmirx_dev->phy_rw_lock);
 	mutex_init(&hdmirx_dev->stream_lock);
 	mutex_init(&hdmirx_dev->work_lock);
-	spin_lock_init(&hdmirx_dev->rst_lock);
+	raw_spin_lock_init(&hdmirx_dev->rst_lock);
 
 	init_completion(&hdmirx_dev->cr_read_done);
 	init_completion(&hdmirx_dev->cr_write_done);
