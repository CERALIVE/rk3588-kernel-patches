+/*
+ * Decide whether the per-class split actually consumed the WHOLE request.
+ *
+ * A register request is split across every class it overlaps and each part is
+ * clamped to that class's own range, so any byte of the request that no class
+ * owns is quietly dropped instead of refused. The register map has real holes
+ * (class BASE ends at 0x0058, class PIC starts at 0x0280) and a hard end (class
+ * DBG ends at 0x5354), so a request running off the end of a class -- or across
+ * one of those holes -- was accepted with part of it silently discarded, and
+ * userspace was told the registers it named had been programmed. That is
+ * `class-overrun` in tests/expected-errno.tsv, which expected -EINVAL and got
+ * success.
+ *
+ * reg_msg[]'s classes are DISJOINT, so each clamped part is a distinct subrange
+ * of the request and the parts can only sum to the request's own size when
+ * every byte of it landed inside some class. Comparing those two numbers is
+ * therefore an exact containment test, and it assumes nothing about the order
+ * the classes are declared in.
+ */
+static int req_fully_covered(const struct mpp_request *req, u32 covered)
+{
+	if (covered != req->size)
+		return -EINVAL;
+
+	return 0;
+}
+
 /* ---- Check if request overlaps a class ---- */
 static bool req_over_class(struct mpp_request *req,
 			   struct rkvenc_task *task, u32 class)
