+/*
+ * TRANSIENT teardown: one core is unbinding, the service is not. Same drain --
+ * in-flight work still has to be aborted and every file descriptor still has to
+ * be waited for before the core frees the IRQ and the mappings those sessions
+ * can reach -- but the service goes back to LIVE once the drain has actually
+ * completed, because it has not gone anywhere.
+ *
+ * PRECONDITION: the caller has already cleared sub_devices[MPP_DEVICE_RKVENC]
+ * under session_lock. That pointer, not `state`, is what keeps new opens out
+ * while the core is absent, and unlike `state` it is REVERSIBLE -- the core's
+ * next successful probe repopulates it. Leaving the service DEAD here instead
+ * is what made a single core's unbind kill /dev/mpp_service for the rest of the
+ * boot: nothing anywhere restores LIVE, so every later open() saw -ENODEV even
+ * after the core had re-probed cleanly and republished itself.
+ *
+ * A drain that TIMED OUT still goes DEAD. Sessions that outlived it are still
+ * pointing at the core that is being torn down, and admitting one more
+ * submission from them is exactly the use-after-free the drain exists to
+ * prevent; refusing to come back is the safe direction.
+ */
+void rkvenc_service_quiesce_for_core(struct rkvenc_service *srv)
+{
+	enum rkvenc_drain_result res;
+
+	if (!srv)
+		return;
+
+	res = rkvenc_service_drain(srv);
+	if (res == RKVENC_DRAIN_NOT_OWNER)
+		return;
+
+	mutex_lock(&srv->session_lock);
+	srv->state = (res == RKVENC_DRAIN_COMPLETE) ? RKVENC_SRV_LIVE
+						    : RKVENC_SRV_DEAD;
+	mutex_unlock(&srv->session_lock);
+}
