+					   req->offset, req->size, cov.bytes);
+				goto fail;
+			}
 		} break;
 		case MPP_CMD_SET_REG_READ: {
+			struct req_coverage cov = { .lo = U32_MAX };
 			struct mpp_request *rreq;
 
 			for (j = 0; j < hw->reg_class; j++) {
 				if (!req_over_class(req, task, j))
