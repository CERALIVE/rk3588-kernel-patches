+/* ---- Task-queue publication ---- */
+/*
+ * Publication is what makes a core DISPATCHABLE: rkvenc_task_worker_default()
+ * will hand a task to any core that has both a queue slot and an idle bit. The
+ * two halves are a pair, and 0024 adds two more call sites for them (the CCU
+ * re-share and the main-core unbind), so they live in one place rather than
+ * being open-coded four times and drifting.
+ *
+ * Both are idempotent through RKVENC_STAGE_QUEUE_PUBLISHED, so a re-publish of
+ * an already-published core cannot double-count core_count.
+ */
+static void rkvenc_queue_publish_core(struct rkvenc_taskqueue *queue,
+				      struct rkvenc_dev *enc)
+{
+	if (!queue || enc->core_id < 0 || enc->core_id >= MPP_MAX_CORE_NUM)
+		return;
+	if (test_and_set_bit(RKVENC_STAGE_QUEUE_PUBLISHED, &enc->probe_stages))
+		return;
+
+	mutex_lock(&queue->dev_lock);
+	queue->cores[enc->core_id] = enc;
+	queue->core_count++;
+	if (enc->core_id > queue->core_id_max)
+		queue->core_id_max = enc->core_id;
+	set_bit(enc->core_id, &queue->core_idle);
+	mutex_unlock(&queue->dev_lock);
+}
+
+static void rkvenc_queue_unpublish_core(struct rkvenc_taskqueue *queue,
+					struct rkvenc_dev *enc)
+{
+	u32 i;
+
+	if (!queue)
+		return;
+	if (!test_and_clear_bit(RKVENC_STAGE_QUEUE_PUBLISHED, &enc->probe_stages))
+		return;
+
+	mutex_lock(&queue->dev_lock);
+	if (enc->core_id >= 0 && enc->core_id < MPP_MAX_CORE_NUM &&
+	    queue->cores[enc->core_id] == enc) {
+		queue->cores[enc->core_id] = NULL;
+		clear_bit(enc->core_id, &queue->core_idle);
+		if (queue->core_count)
+			queue->core_count--;
+	}
+	/* core_id_max is a HIGH-WATER MARK, so it has to be recomputed
+	 * rather than decremented: removing core 0 must not lower it
+	 * while core 1 is still present.
+	 */
+	queue->core_id_max = 0;
+	for (i = 0; i < MPP_MAX_CORE_NUM; i++)
+		if (queue->cores[i])
+			queue->core_id_max = i;
+	mutex_unlock(&queue->dev_lock);
+}
