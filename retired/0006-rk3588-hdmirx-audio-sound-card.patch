diff --git a/arch/arm64/boot/dts/rockchip/rk3588-extra.dtsi b/arch/arm64/boot/dts/rockchip/rk3588-extra.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3588-extra.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588-extra.dtsi
@@ -23,6 +23,30 @@
 		};
 	};
 
+	hdmirx_sound: hdmirx-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,bitclock-master = <&hdmirx_codec_dai>;
+		simple-audio-card,format = "i2s";
+		simple-audio-card,frame-master = <&hdmirx_codec_dai>;
+		simple-audio-card,mclk-fs = <128>;
+		simple-audio-card,name = "hdmirx";
+		status = "disabled";
+
+		/*
+		 * The receiver recovers the audio clock from the incoming
+		 * stream, so it drives both BCLK and LRCK and i2s7_8ch is the
+		 * consumer. sound-dai resolves to the hdmi-audio-codec child
+		 * device that snps_hdmirx registers under this node.
+		 */
+		hdmirx_codec_dai: simple-audio-card,codec {
+			sound-dai = <&hdmi_receiver>;
+		};
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s7_8ch>;
+		};
+	};
+
 	reserved-memory {
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -338,6 +362,7 @@
 		reset-names = "axi", "apb", "ref", "biu";
 		rockchip,grf = <&sys_grf>;
 		rockchip,vo1-grf = <&vo1_grf>;
+		#sound-dai-cells = <0>;
 		status = "disabled";
 	};
 
