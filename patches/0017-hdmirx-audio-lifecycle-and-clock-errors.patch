From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andres Cera <andres.cera@hotmail.com>
Date: Sun, 10 Aug 2026 13:00:00 -0500
Subject: [PATCH 17/39] media: synopsys: hdmirx: fix the audio work and clock lifecycle under lockdep

MOTIVATION. hdmi-codec invokes ->hook_plugged_cb() under the ASoC
card mutex, and the installed callback reports a jack under the
card's DAPM locks -- so any path holding work_lock that calls into
the codec closes a cycle (card -> work_lock -> DAPM), the same
shape that already deadlocked the CeraLive vendor series, firing
only when audio is present. Separately, hdmirx_plugout()'s
cancel_delayed_work() does not wait for a running worker, and the
worker unconditionally reschedules itself, so audio work kept
polling and reporting present after every plugout.

BEHAVIOUR. A synchronous cancel of delayed_work_audio is never
performed under work_lock (enforced via
lockdep_assert_not_held()); hook_plugged_cb() publishes the
callback under the lock and invokes it with the lock dropped. An
explicit armed gate replaces the ineffective async cancel: the
worker checks it on entry and before re-arming, with a separate
synchronous drain each caller makes after dropping work_lock.
clk_set_rate() returns are now propagated instead of discarded, so
a refused rate no longer updates audio_state as if it had taken.
768000 is removed from supported_fs (CEA-861 tops out at 192 kHz;
its only effect was letting a garbage ACR-derived frequency pass
is_validfs()). audio_state's clock rate and audio_present move
under a dedicated leaf lock, published before the codec callback
rather than after.

NON-GOALS. Does not add a synchronous cancel under work_lock --
that path is exactly what the lock order forbids. Does not touch
the audio FIFO/ACR sample-rate recovery logic 0005 owns.

PROVENANCE. First-party CeraLive fix to the imported 0005 audio
path; no upstream counterpart -- the PATCHv4 counterpart to 0005
does not carry this audio worker at all.

EVIDENCE POINTER. Source-verified and build-clean; hardware
validation pending. Lock order enumerated from v7.1.7's own
sound/soc/codecs/hdmi-codec.c. Two 0013-gated controls
(delay_worker_ms, fail_clk_set_rate_once) force the races on
demand; harness: tests/hdmirx-audio-fault-qa.sh under lockdep. See
docs/BOARD-QUALIFICATION.md.

First-party: authored by CeraLive against v7.2, with no upstream
counterpart in rockchip-rk3588-mainline-patches. The source of record is
ceralive/0017-hdmirx-audio-lifecycle-and-clock-errors.patch; patches/ is generated from it by
scripts/build-series.py, and scripts/verify-payload-parity.py holds it to the
same added/removed-line parity the upstream lane gets.

NOT upstream-bound: this targets the CeraLive device tree only and is not a
submission to linux-media, linux-rockchip or the fork parent. No Signed-off-by
is added, because a DCO assertion belongs to whoever actually submits it.

---
diff --git a/drivers/media/platform/synopsys/hdmirx/Makefile b/drivers/media/platform/synopsys/hdmirx/Makefile
--- a/drivers/media/platform/synopsys/hdmirx/Makefile
+++ b/drivers/media/platform/synopsys/hdmirx/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
 synopsys-hdmirx-objs := snps_hdmirx.o snps_hdmirx_cec.o
+synopsys-hdmirx-$(CONFIG_VIDEO_ROCKCHIP_HDMIRX_CERALIVE_TEST) += snps_hdmirx_test.o
 
 obj-$(CONFIG_VIDEO_SYNOPSYS_HDMIRX) += synopsys-hdmirx.o
diff --git a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
--- a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
+++ b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
@@ -44,6 +44,7 @@
 #include <sound/hdmi-codec.h>
 
 #include "snps_hdmirx.h"
+#include "snps_hdmirx_test.h"
 #include "snps_hdmirx_cec.h"
 
 #define EDID_NUM_BLOCKS_MAX				4
@@ -156,8 +157,32 @@ struct snps_hdmirx_dev {
 	struct clk *aud_clk;
 	int audio_present;
 	struct mutex phy_rw_lock; /* to protect phy r/w configuration */
+	/*
+	 * LOCK ORDER, enumerated because getting it wrong here is a deadlock
+	 * that only fires when audio is actually present:
+	 *
+	 *   work_lock  -> audio_lock          (hotplug disarms the audio work)
+	 *   audio_lock -> nothing             (leaf; never sleeps, never calls out)
+	 *
+	 * The ASoC codec locks are deliberately OUTSIDE both. hdmi-codec invokes
+	 * ->hook_plugged_cb() from its component probe/remove, i.e. under the
+	 * ASoC card mutex, and the callback it installs (plugged_cb) reports a
+	 * jack, which takes the card's own DAPM locks. So any path that holds
+	 * work_lock and then calls into the codec closes a cycle:
+	 *
+	 *   ASoC   holds card mutex  -> blocked on work_lock (hook_plugged_cb)
+	 *   driver holds work_lock   -> waits for the audio worker (sync cancel)
+	 *   worker                   -> blocked on the card/DAPM lock ASoC holds
+	 *
+	 * Two rules follow, and both are enforced below rather than hoped for:
+	 * a SYNCHRONOUS cancel of delayed_work_audio is never performed while
+	 * work_lock is held, and hook_plugged_cb() never calls the codec back
+	 * while holding it either.
+	 */
 	struct mutex stream_lock; /* to lock video stream capture */
 	struct mutex work_lock; /* to lock the critical section of hotplug event */
+	spinlock_t audio_lock; /* leaf lock for audio_state/audio_present/arm gate */
+	bool audio_work_armed;
 	struct reset_control_bulk_data resets[HDMIRX_NUM_RST];
 	struct clk_bulk_data *clks;
 	struct regmap *grf;
@@ -640,8 +665,16 @@ static void hdmirx_interrupts_setup(struct snps_hdmirx_dev *hdmirx_dev, bool en)
 
 /* -------------------- HDMI RX Audio Support -------------------- */
 
+/*
+ * HDMI carries at most 192 kHz (CEA-861 audio sample frequency, 3 bits, top
+ * code 192 kHz). 768000 is not a rate any HDMI source can send, and the receiver
+ * cannot produce it either: hdmirx_audio_set_fs() would ask the audio clock for
+ * 768000 * 128 = 98.304 MHz, which is outside its range. Its only reachable
+ * effect was through is_validfs(), where it let a garbage ACR-derived frequency
+ * be accepted as valid and programmed. Removed.
+ */
 static const int supported_fs[] = {
-	32000, 44100, 48000, 88200, 96000, 176400, 192000, 768000, -1
+	32000, 44100, 48000, 88200, 96000, 176400, 192000, -1
 };
 
 static bool is_validfs(int fs)
@@ -713,14 +746,41 @@ static u32 hdmirx_audio_ch(struct snps_hdmirx_dev *hdmirx_dev)
 	return ch;
 }
 
-static void hdmirx_audio_set_fs(struct snps_hdmirx_dev *hdmirx_dev, u32 fs_audio)
+/*
+ * Returns 0 or the clock's own error. The return used to be discarded, so a
+ * REFUSED rate still updated audio_state -- leaving the driver believing it had
+ * a recovered audio clock it does not have, and every subsequent ppm correction
+ * computed from a rate the hardware never accepted. On failure the previously
+ * programmed rate is kept, because a stale-but-real rate is recoverable and a
+ * recorded-but-fictional one is not.
+ */
+static int hdmirx_audio_set_fs(struct snps_hdmirx_dev *hdmirx_dev, u32 fs_audio)
 {
 	u32 hdmirx_aud_clkrate_t = fs_audio * 128;
+	unsigned long flags;
+	int ret = 0;
 
-	if (hdmirx_dev->aud_clk)
-		clk_set_rate(hdmirx_dev->aud_clk, hdmirx_aud_clkrate_t);
+	if (hdmirx_dev->aud_clk) {
+		if (hdmirx_test_fail_clk_set_rate())
+			ret = -EIO;
+		else
+			ret = clk_set_rate(hdmirx_dev->aud_clk,
+					   hdmirx_aud_clkrate_t);
+		if (ret) {
+			dev_err(hdmirx_dev->dev,
+				"failed to set the audio clock to %u Hz for fs %u: %d; keeping %u Hz\n",
+				hdmirx_aud_clkrate_t, fs_audio, ret,
+				hdmirx_dev->audio_state.hdmirx_aud_clkrate);
+			return ret;
+		}
+	}
+
+	spin_lock_irqsave(&hdmirx_dev->audio_lock, flags);
 	hdmirx_dev->audio_state.hdmirx_aud_clkrate = hdmirx_aud_clkrate_t;
 	hdmirx_dev->audio_state.fs_audio = fs_audio;
+	spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
+
+	return 0;
 }
 
 static void hdmirx_audio_fifo_init(struct snps_hdmirx_dev *hdmirx_dev)
@@ -754,8 +814,13 @@ static void hdmirx_audio_handle_plugged_change(struct snps_hdmirx_dev *hdmirx_de
 static void hdmirx_audio_clk_ppm_inc(struct snps_hdmirx_dev *hdmirx_dev, int ppm)
 {
 	int delta, rate, inc;
+	unsigned long flags;
+	int ret;
 
+	spin_lock_irqsave(&hdmirx_dev->audio_lock, flags);
 	rate = hdmirx_dev->audio_state.hdmirx_aud_clkrate;
+	spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
+
 	if (ppm < 0) {
 		ppm = -ppm;
 		inc = -1;
@@ -765,9 +830,29 @@ static void hdmirx_audio_clk_ppm_inc(struct snps_hdmirx_dev *hdmirx_dev, int ppm
 	delta = (int)div64_u64((u64)rate * ppm + 500000, 1000000);
 	delta *= inc;
 	rate += delta;
-	if (hdmirx_dev->aud_clk)
-		clk_set_rate(hdmirx_dev->aud_clk, rate);
+
+	if (hdmirx_dev->aud_clk) {
+		if (hdmirx_test_fail_clk_set_rate())
+			ret = -EIO;
+		else
+			ret = clk_set_rate(hdmirx_dev->aud_clk, rate);
+		if (ret) {
+			/*
+			 * A rejected drift correction is not fatal -- the next
+			 * pass recomputes from the RECORDED rate, so leaving
+			 * that record untouched is what keeps the loop
+			 * convergent instead of walking it away from reality.
+			 */
+			dev_warn_ratelimited(hdmirx_dev->dev,
+					     "audio clock drift correction to %d Hz refused: %d\n",
+					     rate, ret);
+			return;
+		}
+	}
+
+	spin_lock_irqsave(&hdmirx_dev->audio_lock, flags);
 	hdmirx_dev->audio_state.hdmirx_aud_clkrate = rate;
+	spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
 }
 
 static int hdmirx_audio_clk_adjust(struct snps_hdmirx_dev *hdmirx_dev,
@@ -823,7 +908,9 @@ static void hdmirx_audio_setup(struct snps_hdmirx_dev *hdmirx_dev)
 	as->pre_state = 0;
 	as->init_state = INIT_FIFO_STATE * 4;
 	as->audio_enabled = false;
-	hdmirx_audio_set_fs(hdmirx_dev, 44100);
+	if (hdmirx_audio_set_fs(hdmirx_dev, 44100))
+		dev_warn(hdmirx_dev->dev,
+			 "audio setup could not program the default 44.1 kHz clock\n");
 	hdmirx_update_bits(hdmirx_dev, GLOBAL_SWENABLE, AUDIO_ENABLE, 0);
 	hdmirx_writel(hdmirx_dev, AUDIO_FIFO_THR_PASS, INIT_FIFO_STATE);
 	hdmirx_writel(hdmirx_dev, AUDIO_FIFO_THR,
@@ -842,6 +929,29 @@ static void hdmirx_delayed_work_audio(struct work_struct *work)
 	u32 fs_audio, ch_audio;
 	int cur_state, init_state, pre_state, fifo_status2;
 	unsigned long delay = 200;
+	unsigned int test_delay_ms;
+	unsigned long flags;
+
+	/*
+	 * Stretches the worker so a cancel races a RUNNING worker rather than an
+	 * idle one. Compiles to nothing without the test symbol.
+	 */
+	test_delay_ms = hdmirx_test_worker_delay_ms();
+	if (test_delay_ms)
+		msleep(test_delay_ms);
+
+	/*
+	 * Disarmed while this ran, so the receiver is being torn down or has
+	 * already been unplugged. Return WITHOUT re-arming: the tail of this
+	 * function unconditionally reschedules, which is what made the async
+	 * cancel in hdmirx_plugout() ineffective -- the work simply came back.
+	 */
+	spin_lock_irqsave(&hdmirx_dev->audio_lock, flags);
+	if (!hdmirx_dev->audio_work_armed) {
+		spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
 
 	if (!as->audio_enabled) {
 		dev_info(hdmirx_dev->dev, "%s: enable audio\n", __func__);
@@ -858,8 +968,8 @@ static void hdmirx_delayed_work_audio(struct work_struct *work)
 		dev_warn(hdmirx_dev->dev, "%s: audio %s %#x, with fs %svalid %d\n",
 			 __func__, audio_fifo_err(fifo_status2), fifo_status2,
 			 is_validfs(fs_audio) ? "" : "in", fs_audio);
-		if (is_validfs(fs_audio)) {
-			hdmirx_audio_set_fs(hdmirx_dev, fs_audio);
+		if (is_validfs(fs_audio) &&
+		    !hdmirx_audio_set_fs(hdmirx_dev, fs_audio)) {
 			as->ch_audio = ch_audio;
 			hdmirx_enable_audio_output(hdmirx_dev, ch_audio);
 		}
@@ -885,44 +995,89 @@ static void hdmirx_delayed_work_audio(struct work_struct *work)
 			 "%s: restart audio fs(%d -> %d) ch(%d -> %d)\n",
 			 __func__, as->fs_audio, fs_audio,
 			 as->ch_audio, ch_audio);
-		hdmirx_audio_set_fs(hdmirx_dev, fs_audio);
-		as->ch_audio = ch_audio;
-		hdmirx_enable_audio_output(hdmirx_dev, ch_audio);
+		/*
+		 * Only adopt the new format once the clock has actually been
+		 * programmed for it. Enabling the output against a rate the
+		 * clock refused is what produced a card that reports a rate it
+		 * is not clocking.
+		 */
+		if (!hdmirx_audio_set_fs(hdmirx_dev, fs_audio)) {
+			as->ch_audio = ch_audio;
+			hdmirx_enable_audio_output(hdmirx_dev, ch_audio);
+		}
 		hdmirx_audio_fifo_init(hdmirx_dev);
 		as->pre_state = 0;
 		goto exit;
 	}
 
 	if (cur_state != 0) {
-		if (!hdmirx_dev->audio_present) {
+		if (!READ_ONCE(hdmirx_dev->audio_present)) {
 			dev_info(hdmirx_dev->dev, "audio on\n");
+			WRITE_ONCE(hdmirx_dev->audio_present, true);
 			hdmirx_audio_handle_plugged_change(hdmirx_dev, true);
-			hdmirx_dev->audio_present = true;
 		}
 		delay = hdmirx_audio_clk_adjust(hdmirx_dev,
 						 cur_state - init_state,
 						 cur_state - pre_state);
 	} else {
-		if (hdmirx_dev->audio_present) {
+		if (READ_ONCE(hdmirx_dev->audio_present)) {
 			dev_info(hdmirx_dev->dev, "audio off\n");
+			WRITE_ONCE(hdmirx_dev->audio_present, false);
 			hdmirx_audio_handle_plugged_change(hdmirx_dev, false);
-			hdmirx_dev->audio_present = false;
 		}
 	}
 	as->pre_state = cur_state;
 
 exit:
-	schedule_delayed_work(&hdmirx_dev->delayed_work_audio,
-			      msecs_to_jiffies(delay));
+	/* Re-arm only while still armed -- see the early return above. */
+	spin_lock_irqsave(&hdmirx_dev->audio_lock, flags);
+	if (hdmirx_dev->audio_work_armed)
+		schedule_delayed_work(&hdmirx_dev->delayed_work_audio,
+				      msecs_to_jiffies(delay));
+	spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
+}
+
+/*
+ * Disarm + NON-blocking cancel. Safe to call with work_lock held, because it
+ * neither sleeps nor calls into the ASoC codec. It does not guarantee the
+ * worker has finished -- hdmirx_audio_drain() does, and its caller must invoke
+ * it with work_lock DROPPED.
+ */
+static void hdmirx_audio_disarm(struct snps_hdmirx_dev *hdmirx_dev)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hdmirx_dev->audio_lock, flags);
+	hdmirx_dev->audio_work_armed = false;
+	spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
+
+	cancel_delayed_work(&hdmirx_dev->delayed_work_audio);
+}
+
+/*
+ * The SYNCHRONOUS half. MUST NOT be called with work_lock held: this waits for
+ * the audio worker, and that worker calls the ASoC plugged callback, which
+ * takes card/DAPM locks that hdmi-codec's ->hook_plugged_cb path holds while it
+ * blocks on work_lock. See the lock-order comment on struct snps_hdmirx_dev.
+ */
+static void hdmirx_audio_drain(struct snps_hdmirx_dev *hdmirx_dev)
+{
+	lockdep_assert_not_held(&hdmirx_dev->work_lock);
+	cancel_delayed_work_sync(&hdmirx_dev->delayed_work_audio);
 }
 
 static void hdmirx_audio_set_state(struct snps_hdmirx_dev *hdmirx_dev, bool on)
 {
+	unsigned long flags;
+
 	if (on) {
+		spin_lock_irqsave(&hdmirx_dev->audio_lock, flags);
+		hdmirx_dev->audio_work_armed = true;
+		spin_unlock_irqrestore(&hdmirx_dev->audio_lock, flags);
 		schedule_delayed_work(&hdmirx_dev->delayed_work_audio,
 				      HZ / 2);
 	} else {
-		cancel_delayed_work_sync(&hdmirx_dev->delayed_work_audio);
+		hdmirx_audio_disarm(hdmirx_dev);
 		hdmirx_update_bits(hdmirx_dev, GLOBAL_SWENABLE,
 				   AUDIO_ENABLE, 0);
 	}
@@ -962,13 +1117,23 @@ static int hdmirx_audio_hook_plugged_cb(struct device *dev, void *data,
 					 struct device *codec_dev)
 {
 	struct snps_hdmirx_dev *hdmirx_dev = dev_get_drvdata(dev);
+	bool plugged;
 
+	/*
+	 * ASoC calls this from hdmi_codec's component probe/remove, i.e. under
+	 * the card mutex, and the callback being installed reports a jack --
+	 * which takes the card's own DAPM locks. Calling it while holding
+	 * work_lock therefore establishes card -> work_lock -> DAPM, and closes
+	 * a cycle against any path that waits for the audio worker under
+	 * work_lock. Publish under the lock; call back with it DROPPED.
+	 */
 	mutex_lock(&hdmirx_dev->work_lock);
 	hdmirx_dev->plugged_cb = fn;
 	hdmirx_dev->codec_dev = codec_dev;
-	hdmirx_audio_handle_plugged_change(hdmirx_dev,
-					   tx_5v_power_present(hdmirx_dev));
+	plugged = tx_5v_power_present(hdmirx_dev);
 	mutex_unlock(&hdmirx_dev->work_lock);
+
+	hdmirx_audio_handle_plugged_change(hdmirx_dev, plugged);
 	return 0;
 }
 
@@ -1020,9 +1185,16 @@ static void hdmirx_plugout(struct snps_hdmirx_dev *hdmirx_dev)
 	if (!hdmirx_dev->plugged)
 		return;
 
+	/*
+	 * Disarm BEFORE reporting the change, so a worker that is mid-flight
+	 * cannot re-arm itself behind us. The synchronous drain belongs to the
+	 * caller, which runs it after dropping work_lock -- doing it here would
+	 * wait for the worker while holding the very lock the ASoC callback
+	 * path needs.
+	 */
+	hdmirx_audio_disarm(hdmirx_dev);
+	WRITE_ONCE(hdmirx_dev->audio_present, false);
 	hdmirx_audio_handle_plugged_change(hdmirx_dev, false);
-	cancel_delayed_work(&hdmirx_dev->delayed_work_audio);
-	hdmirx_dev->audio_present = false;
 
 	hdmirx_update_bits(hdmirx_dev, SCDC_CONFIG, POWERPROVIDED, 0);
 	hdmirx_interrupts_setup(hdmirx_dev, false);
@@ -2660,12 +2832,21 @@ static void hdmirx_delayed_work_hotplug(struct work_struct *work)
 		hdmirx_plugin(hdmirx_dev);
 
 	mutex_unlock(&hdmirx_dev->work_lock);
+
+	/*
+	 * OUTSIDE work_lock, and only when we did not just re-arm: this is the
+	 * synchronous wait for the audio worker, and the worker calls into the
+	 * ASoC codec.
+	 */
+	if (!plugin)
+		hdmirx_audio_drain(hdmirx_dev);
 }
 
 static void hdmirx_delayed_work_res_change(struct work_struct *work)
 {
 	struct snps_hdmirx_dev *hdmirx_dev;
 	bool plugin;
+	bool drained = false;
 
 	hdmirx_dev = container_of(work, struct snps_hdmirx_dev,
 				  delayed_work_res_change.work);
@@ -2690,9 +2871,14 @@ static void hdmirx_delayed_work_res_change(struct work_struct *work)
 			hdmirx_dma_config(hdmirx_dev);
 			hdmirx_interrupts_setup(hdmirx_dev, true);
 			hdmirx_audio_set_state(hdmirx_dev, true);
+			drained = true;
 		}
 	}
 	mutex_unlock(&hdmirx_dev->work_lock);
+
+	/* See hdmirx_delayed_work_hotplug(): synchronous, so lock-free. */
+	if (!drained)
+		hdmirx_audio_drain(hdmirx_dev);
 }
 
 static irqreturn_t hdmirx_5v_det_irq_handler(int irq, void *dev_id)
@@ -2917,6 +3103,12 @@ static int hdmirx_disable(struct device *dev)
 	struct v4l2_device *v4l2_dev = &hdmirx_dev->v4l2_dev;
 
 	hdmirx_plugout(hdmirx_dev);
+	/*
+	 * The clocks are about to go away, so the worker must be PROVEN stopped
+	 * rather than merely asked to stop. hdmirx_disable() holds no lock of
+	 * ours, so the synchronous wait is legal here.
+	 */
+	hdmirx_audio_drain(hdmirx_dev);
 	hdmirx_hpd_ctrl(hdmirx_dev, false);
 
 	clk_bulk_disable_unprepare(hdmirx_dev->num_clks, hdmirx_dev->clks);
@@ -3139,6 +3331,8 @@ static int hdmirx_probe(struct platform_device *pdev)
 	mutex_init(&hdmirx_dev->phy_rw_lock);
 	mutex_init(&hdmirx_dev->stream_lock);
 	mutex_init(&hdmirx_dev->work_lock);
+	spin_lock_init(&hdmirx_dev->audio_lock);
+	hdmirx_dev->audio_work_armed = false;
 	spin_lock_init(&hdmirx_dev->rst_lock);
 
 	init_completion(&hdmirx_dev->cr_read_done);
@@ -3252,7 +3446,13 @@ static void hdmirx_remove(struct platform_device *pdev)
 	struct device *dev = &pdev->dev;
 	struct snps_hdmirx_dev *hdmirx_dev = dev_get_drvdata(dev);
 
-	cancel_delayed_work_sync(&hdmirx_dev->delayed_work_audio);
+	/*
+	 * Disarm, THEN drain. A bare cancel_delayed_work_sync() races a worker
+	 * that is about to reschedule itself: the cancel waits for the current
+	 * run, which re-arms on its way out, and the work survives remove().
+	 */
+	hdmirx_audio_disarm(hdmirx_dev);
+	hdmirx_audio_drain(hdmirx_dev);
 
 	v4l2_debugfs_if_free(hdmirx_dev->infoframes);
 	debugfs_remove_recursive(hdmirx_dev->debugfs_dir);
@@ -3289,7 +3489,25 @@ static struct platform_driver hdmirx_driver = {
 		.pm = &snps_hdmirx_pm_ops,
 	}
 };
-module_platform_driver(hdmirx_driver);
+/*
+ * Expanded from module_platform_driver() so the audio test controls' debugfs
+ * directory has MODULE lifetime rather than device lifetime -- the same reason
+ * rkvenc does it. Both calls compile to nothing without the test symbol, so the
+ * production init path is byte-unchanged.
+ */
+static int __init hdmirx_module_init(void)
+{
+	hdmirx_test_init();
+	return platform_driver_register(&hdmirx_driver);
+}
+module_init(hdmirx_module_init);
+
+static void __exit hdmirx_module_exit(void)
+{
+	platform_driver_unregister(&hdmirx_driver);
+	hdmirx_test_exit();
+}
+module_exit(hdmirx_module_exit);
 
 MODULE_DESCRIPTION("Synopsys HDMI Receiver Driver");
 MODULE_AUTHOR("Dingxian Wen <shawn.wen@rock-chips.com>");
diff --git a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx_test.c b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx_test.c
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx_test.c
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Synopsys HDMI-RX - CeraLive deterministic fault injection for the audio path
+ *
+ * Compiled ONLY under CONFIG_VIDEO_ROCKCHIP_HDMIRX_CERALIVE_TEST. See
+ * snps_hdmirx_test.h for the contract.
+ *
+ * Copyright (C) 2026 CeraLive
+ */
+
+#include <linux/atomic.h>
+#include <linux/debugfs.h>
+#include <linux/module.h>
+
+#include "snps_hdmirx_test.h"
+
+#define HDMIRX_TEST_DIR_NAME "hdmirx-audio-test"
+
+static atomic_t delay_worker_ms;
+static atomic_t delay_worker_consumed;
+static atomic_t fail_clk_set_rate_once;
+static atomic_t fail_clk_set_rate_consumed;
+
+static struct dentry *hdmirx_test_dir;
+
+void hdmirx_test_init(void)
+{
+	if (hdmirx_test_dir)
+		return;
+
+	hdmirx_test_dir = debugfs_create_dir(HDMIRX_TEST_DIR_NAME, NULL);
+
+	debugfs_create_atomic_t("delay_worker_ms", 0600, hdmirx_test_dir,
+				&delay_worker_ms);
+	debugfs_create_atomic_t("delay_worker_consumed", 0400, hdmirx_test_dir,
+				&delay_worker_consumed);
+	debugfs_create_atomic_t("fail_clk_set_rate_once", 0600, hdmirx_test_dir,
+				&fail_clk_set_rate_once);
+	debugfs_create_atomic_t("fail_clk_set_rate_consumed", 0400,
+				hdmirx_test_dir, &fail_clk_set_rate_consumed);
+
+	pr_info("snps_hdmirx: CeraLive audio test controls at /sys/kernel/debug/%s (NOT a production kernel)\n",
+		HDMIRX_TEST_DIR_NAME);
+}
+
+void hdmirx_test_exit(void)
+{
+	debugfs_remove_recursive(hdmirx_test_dir);
+	hdmirx_test_dir = NULL;
+}
+
+unsigned int hdmirx_test_worker_delay_ms(void)
+{
+	int ms = atomic_xchg(&delay_worker_ms, 0);
+
+	/*
+	 * A negative value can only come from a debugfs write, and treating it
+	 * as a huge unsigned delay would park the audio worker indefinitely.
+	 * Consume it so the knob still auto-resets, and report no delay.
+	 */
+	if (ms <= 0)
+		return 0;
+
+	atomic_inc(&delay_worker_consumed);
+	return (unsigned int)ms;
+}
+
+bool hdmirx_test_fail_clk_set_rate(void)
+{
+	/*
+	 * cmpxchg, not read-then-clear: the audio worker and the ASoC callback
+	 * path can both reach a rate update, so a non-atomic consume would let
+	 * one armed fault fire twice and leave the counter disagreeing with
+	 * what happened.
+	 */
+	if (atomic_cmpxchg(&fail_clk_set_rate_once, 1, 0) != 1)
+		return false;
+
+	atomic_inc(&fail_clk_set_rate_consumed);
+	return true;
+}
diff --git a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx_test.h b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx_test.h
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx_test.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+/*
+ * Synopsys HDMI-RX - CeraLive deterministic fault injection for the audio path
+ *
+ * PRODUCTION-ABSENT BY CONSTRUCTION, exactly as rkvenc_test.h is: every entry
+ * point is a static inline returning a compile-time constant when
+ * CONFIG_VIDEO_ROCKCHIP_HDMIRX_CERALIVE_TEST is off, so each call site collapses
+ * to nothing -- no branch, no symbol, no debugfs directory.
+ *
+ * The two controls exist for the two claims the audio lifecycle fix makes, and
+ * neither is testable without them:
+ *
+ *   delay_worker_ms         widens the audio worker's execution window so a
+ *                           synchronous cancel genuinely races a RUNNING worker
+ *                           rather than an idle one. Without it, a lock-order
+ *                           bug in the cancel path is a race nobody loses on a
+ *                           bench board, and lockdep never sees the edge.
+ *   fail_clk_set_rate_once  forces one clk_set_rate() refusal, which real
+ *                           hardware does not do on demand, so the error path
+ *                           that used to be unreachable-and-untested becomes
+ *                           both reachable and asserted.
+ *
+ * Same contract as the rkvenc controls: mode 0600, one-shot, auto-reset to 0,
+ * and a read-only <name>_consumed counter that increments exactly once per
+ * consumption so a harness can tell a fault that fired from a knob the driver
+ * ignored.
+ *
+ * Copyright (C) 2026 CeraLive
+ */
+
+#ifndef __SNPS_HDMIRX_TEST_H__
+#define __SNPS_HDMIRX_TEST_H__
+
+#include <linux/types.h>
+
+#if IS_ENABLED(CONFIG_VIDEO_ROCKCHIP_HDMIRX_CERALIVE_TEST)
+
+void hdmirx_test_init(void);
+void hdmirx_test_exit(void);
+
+unsigned int hdmirx_test_worker_delay_ms(void);
+bool hdmirx_test_fail_clk_set_rate(void);
+
+#else /* !CONFIG_VIDEO_ROCKCHIP_HDMIRX_CERALIVE_TEST */
+
+static inline void hdmirx_test_init(void) { }
+static inline void hdmirx_test_exit(void) { }
+
+static inline unsigned int hdmirx_test_worker_delay_ms(void) { return 0; }
+static inline bool hdmirx_test_fail_clk_set_rate(void) { return false; }
+
+#endif /* CONFIG_VIDEO_ROCKCHIP_HDMIRX_CERALIVE_TEST */
+
+#endif /* __SNPS_HDMIRX_TEST_H__ */
