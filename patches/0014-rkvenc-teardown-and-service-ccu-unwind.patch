From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andres Cera <andres.cera@hotmail.com>
Date: Sun, 10 Aug 2026 10:00:00 -0500
Subject: [PATCH 14/26] media: rockchip: rkvenc: fix session teardown and unwind probe stages in reverse

MOTIVATION. Six defects in 0001's teardown path, all in code that
runs only when something goes away: a session freed while a task is
still in flight on the release drain's timeout path; that drain
sleeping under the lock its own completion path needs; a failed CCU
attach leaving a dangling list entry into freed memory; remove()
clearing almost none of the state it published; the service tearing
itself down under open file descriptors; and a devm IRQ outliving
the state it touches across remove().

BEHAVIOUR. Three parts. device_link_add() from each core to its
service and CCU suppliers (DL_FLAG_AUTOREMOVE_CONSUMER |
DL_FLAG_PM_RUNTIME) so unbind ordering and PM sequencing are
structural rather than assumed. A service lifetime state --
LIVE -> QUIESCING -> DEAD -- guarded by the EXISTING session_lock,
refusing new opens/submissions, waking parked task waiters, and
draining before any supplier-owned resource releases; an aborted
task now reports -ENODEV rather than a stale success. A probe-stage
ledger: one bit per completed step, walked in exact reverse by both
the probe error path and remove(), idempotent per step.

NON-GOALS. Does not change the encoder's data path or ioctl surface
(see 0016 for that). Does not add a new lock -- the service state
machine reuses the existing session_lock by design.

PROVENANCE. First-party CeraLive fix to the imported 0001 driver; no
upstream counterpart.

EVIDENCE POINTER. Source-verified and build-clean at W=1 in both
configurations; hardware validation pending. Forced by 0013's
controls and exercised by tests/rkvenc-unbind.sh (idle, held-open-FD,
and queued/in-flight supplier unbinds, including a deliberate
no-close `timeout-negative` fixture that must FAIL) under KASAN and
lockdep. See docs/BOARD-QUALIFICATION.md.

First-party: authored by CeraLive against v7.1.7, with no upstream
counterpart in rockchip-rk3588-mainline-patches. The source of record is
ceralive/0014-rkvenc-teardown-and-service-ccu-unwind.patch; patches/ is generated from it by
scripts/build-series.py, and scripts/verify-payload-parity.py holds it to the
same added/removed-line parity the upstream lane gets.

NOT upstream-bound: this targets the CeraLive device tree only and is not a
submission to linux-media, linux-rockchip or the fork parent. No Signed-off-by
is added, because a DCO assertion belongs to whoever actually submits it.

---
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc_drv.c b/drivers/media/platform/rockchip/rkvenc/rkvenc_drv.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc_drv.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc_drv.c
@@ -8,6 +8,7 @@
  */
 
 #include <linux/delay.h>
+#include <linux/device.h>
 #include <linux/interrupt.h>
 #include <linux/iommu.h>
 #include <linux/iopoll.h>
@@ -87,14 +88,36 @@ static int rkvenc_attach_ccu(struct device *dev, struct rkvenc_dev *enc)
 		return -ENODEV;
 
 	ccu = platform_get_drvdata(pdev);
-	if (!ccu)
+	if (!ccu) {
+		put_device(&pdev->dev);
 		return -EPROBE_DEFER;
+	}
+
+	/*
+	 * A device link, not a bare pointer. Without it the CCU can unbind
+	 * while cores still dereference enc->ccu, and nothing orders runtime PM
+	 * between them. DL_FLAG_AUTOREMOVE_CONSUMER drops the link (and the
+	 * supplier reference it holds) when this core unbinds, so there is no
+	 * teardown path that can forget to release it; DL_FLAG_PM_RUNTIME makes
+	 * the supplier resume before the consumer and suspend after it.
+	 */
+	enc->ccu_link = device_link_add(dev, &pdev->dev,
+					DL_FLAG_AUTOREMOVE_CONSUMER |
+					DL_FLAG_PM_RUNTIME);
+	/* The link holds its own supplier reference; ours has done its job. */
+	put_device(&pdev->dev);
+	if (!enc->ccu_link) {
+		dev_err(dev, "failed to link this core to its CCU supplier\n");
+		return -ENODEV;
+	}
 
 	INIT_LIST_HEAD(&enc->core_link);
 	mutex_lock(&ccu->lock);
 	ccu->core_num++;
 	list_add_tail(&enc->core_link, &ccu->core_list);
 	mutex_unlock(&ccu->lock);
+	enc->ccu = ccu;
+	set_bit(RKVENC_STAGE_CCU_ATTACHED, &enc->probe_stages);
 
 	/* First core becomes the main core */
 	if (!ccu->main_core) {
@@ -109,6 +132,14 @@ static int rkvenc_attach_ccu(struct device *dev, struct rkvenc_dev *enc)
 		shared = main_iommu ? main_iommu->domain : NULL;
 		if (!shared || !sec_iommu || !sec_iommu->group) {
 			dev_err(dev, "missing IOMMU info for shared domain\n");
+			/*
+			 * This core is ALREADY on ccu->core_list by now. The
+			 * original code returned straight out of here, leaving
+			 * a list entry pointing at a devm allocation the failed
+			 * probe was about to free -- a dangling list head the
+			 * next core walk would follow. The caller's unwind
+			 * removes it, because the stage bit above is set.
+			 */
 			return -ENODEV;
 		}
 
@@ -133,8 +164,8 @@ static int rkvenc_attach_ccu(struct device *dev, struct rkvenc_dev *enc)
 			sec_iommu->rw_sem = &sec_iommu->rw_sem_self;
 			return ret;
 		}
+		set_bit(RKVENC_STAGE_IOMMU_SHARED, &enc->probe_stages);
 	}
-	enc->ccu = ccu;
 
 	dev_info(dev, "attach ccu as core %d%s\n", enc->core_id,
 		 enc == ccu->main_core ? " [main]" :
@@ -173,10 +204,26 @@ static int rkvenc_attach_service(struct rkvenc_dev *enc)
 		return -ENODEV;
 
 	srv = platform_get_drvdata(pdev);
-	if (!srv)
+	if (!srv) {
+		put_device(&pdev->dev);
 		return -EPROBE_DEFER;
+	}
+
+	/* Same contract as the CCU link above: unbinding the service quiesces
+	 * its consumers first, and the link releases itself when this core
+	 * unbinds.
+	 */
+	enc->srv_link = device_link_add(enc->dev, &pdev->dev,
+					DL_FLAG_AUTOREMOVE_CONSUMER |
+					DL_FLAG_PM_RUNTIME);
+	put_device(&pdev->dev);
+	if (!enc->srv_link) {
+		dev_err(enc->dev, "failed to link this core to its service supplier\n");
+		return -ENODEV;
+	}
 
 	enc->srv = srv;
+	set_bit(RKVENC_STAGE_SERVICE_ATTACHED, &enc->probe_stages);
 
 	of_property_read_u32(enc->dev->of_node, "rockchip,taskqueue-node", &taskqueue_node);
 	of_property_read_u32(enc->dev->of_node, "rockchip,resetgroup-node", &resetgroup_node);
@@ -191,11 +238,14 @@ static int rkvenc_attach_service(struct rkvenc_dev *enc)
 
 	/* Register core in the task queue */
 	if (enc->core_id >= 0 && enc->core_id < MPP_MAX_CORE_NUM) {
+		mutex_lock(&queue->dev_lock);
 		queue->cores[enc->core_id] = enc;
 		queue->core_count++;
 		if (enc->core_id > queue->core_id_max)
 			queue->core_id_max = enc->core_id;
 		set_bit(enc->core_id, &queue->core_idle);
+		mutex_unlock(&queue->dev_lock);
+		set_bit(RKVENC_STAGE_QUEUE_PUBLISHED, &enc->probe_stages);
 	}
 
 	/* Attach to reset group */
@@ -296,6 +346,152 @@ static int rkvenc2_alloc_rcbbuf(struct platform_device *pdev, struct rkvenc_dev
 	return 0;
 }
 
+
+/* ---- Reverse-order core unwind ----------------------------------------
+ *
+ * ONE function serves probe failure AND remove, walking the stage ledger in the
+ * exact inverse of acquisition order. Two separate unwinds is how this driver
+ * arrived at a probe error path that undid one of the six steps it had taken
+ * while remove undid a different two, leaving a queue slot, a CCU list entry
+ * and a published sub_device all pointing at freed memory.
+ *
+ * Every step is guarded by its own stage bit and clears it, so the function is
+ * IDEMPOTENT -- calling it twice, or after a partial probe, is a no-op for
+ * anything that never completed.
+ */
+static void rkvenc_core_unwind(struct rkvenc_dev *enc)
+{
+	struct rkvenc_service *srv = enc->srv;
+	struct rkvenc_taskqueue *queue = enc->queue;
+	struct rkvenc_ccu *ccu = enc->ccu;
+
+	/* 8. Stop advertising this core to userspace before anything else: a
+	 * new open must not be able to reach a core that is going away.
+	 */
+	if (test_and_clear_bit(RKVENC_STAGE_SERVICE_PUBLISHED, &enc->probe_stages) && srv) {
+		mutex_lock(&srv->session_lock);
+		if (srv->sub_devices[MPP_DEVICE_RKVENC] == enc) {
+			srv->sub_devices[MPP_DEVICE_RKVENC] = NULL;
+			clear_bit(MPP_DEVICE_RKVENC, &srv->hw_support);
+		}
+		mutex_unlock(&srv->session_lock);
+		rkvenc_service_quiesce(srv);
+	}
+
+	/* 7. Silence the hardware. disable_irq() waits for a handler already
+	 * running on another CPU, and synchronize_irq() covers a threaded tail;
+	 * releasing the handler with devm alone would leave it live all the way
+	 * through the steps below, which free the state it touches.
+	 */
+	if (test_and_clear_bit(RKVENC_STAGE_IRQ_REQUESTED, &enc->probe_stages)) {
+		disable_irq(enc->irq);
+		synchronize_irq(enc->irq);
+		devm_free_irq(enc->dev, enc->irq, enc);
+	}
+	if (queue && queue->kworker_task)
+		kthread_flush_worker(&queue->worker);
+	enc->cur_task = NULL;
+
+	/* 6. SRAM/IOMMU mapping owned by this core. */
+	if (test_and_clear_bit(RKVENC_STAGE_SRAM_MAPPED, &enc->probe_stages) &&
+	    enc->iommu_info && enc->iommu_info->domain) {
+		struct iommu_domain *domain = enc->iommu_info->domain;
+
+		if (enc->rcb_page) {
+			size_t page_size = PAGE_ALIGN(enc->sram_used - enc->sram_size);
+
+			iommu_unmap(domain, enc->sram_iova + enc->sram_size, page_size);
+			__free_pages(enc->rcb_page, get_order(page_size));
+			enc->rcb_page = NULL;
+		}
+		iommu_unmap(domain, enc->sram_iova, enc->sram_size);
+		enc->sram_iova = 0;
+		enc->sram_size = 0;
+		enc->sram_used = 0;
+	}
+
+	/* 5. Secondary cores leave the SHARED domain before its owner does.
+	 * If this core is the main one, every secondary is detached here
+	 * first -- the domain belongs to the main core's IOMMU, so releasing
+	 * it while a secondary is still attached detaches nothing and leaves
+	 * the secondary programmed against page tables that are going away.
+	 */
+	if (ccu && ccu->main_core == enc) {
+		struct rkvenc_dev *sec;
+
+		mutex_lock(&ccu->lock);
+		list_for_each_entry(sec, &ccu->core_list, core_link) {
+			if (sec == enc)
+				continue;
+			if (test_and_clear_bit(RKVENC_STAGE_IOMMU_SHARED,
+					       &sec->probe_stages) &&
+			    sec->iommu_info && sec->iommu_info->domain &&
+			    sec->iommu_info->group) {
+				iommu_detach_group(sec->iommu_info->domain,
+						   sec->iommu_info->group);
+				sec->iommu_info->domain = NULL;
+				sec->iommu_info->rw_sem = &sec->iommu_info->rw_sem_self;
+			}
+		}
+		mutex_unlock(&ccu->lock);
+	}
+	if (test_and_clear_bit(RKVENC_STAGE_IOMMU_SHARED, &enc->probe_stages) &&
+	    enc->iommu_info && enc->iommu_info->domain && enc->iommu_info->group) {
+		iommu_detach_group(enc->iommu_info->domain, enc->iommu_info->group);
+		enc->iommu_info->domain = NULL;
+		enc->iommu_info->rw_sem = &enc->iommu_info->rw_sem_self;
+	}
+
+	/* 4. Leave the CCU. */
+	if (test_and_clear_bit(RKVENC_STAGE_CCU_ATTACHED, &enc->probe_stages) && ccu) {
+		mutex_lock(&ccu->lock);
+		list_del_init(&enc->core_link);
+		if (ccu->core_num)
+			ccu->core_num--;
+		if (ccu->main_core == enc)
+			ccu->main_core = NULL;
+		mutex_unlock(&ccu->lock);
+	}
+	enc->ccu = NULL;
+
+	/* 3. Remove the queue publication: slot, count, id_max and idle bit. */
+	if (test_and_clear_bit(RKVENC_STAGE_QUEUE_PUBLISHED, &enc->probe_stages) && queue) {
+		u32 i;
+
+		mutex_lock(&queue->dev_lock);
+		if (enc->core_id >= 0 && enc->core_id < MPP_MAX_CORE_NUM &&
+		    queue->cores[enc->core_id] == enc) {
+			queue->cores[enc->core_id] = NULL;
+			clear_bit(enc->core_id, &queue->core_idle);
+			if (queue->core_count)
+				queue->core_count--;
+		}
+		/* core_id_max is a HIGH-WATER MARK, so it has to be recomputed
+		 * rather than decremented: removing core 0 must not lower it
+		 * while core 1 is still present.
+		 */
+		queue->core_id_max = 0;
+		for (i = 0; i < MPP_MAX_CORE_NUM; i++)
+			if (queue->cores[i])
+				queue->core_id_max = i;
+		mutex_unlock(&queue->dev_lock);
+	}
+
+	/* 2. Forget the suppliers. The device links themselves are
+	 * AUTOREMOVE_CONSUMER, so the driver core drops them (and the supplier
+	 * references they hold) as this consumer unbinds.
+	 */
+	clear_bit(RKVENC_STAGE_SERVICE_ATTACHED, &enc->probe_stages);
+	enc->srv = NULL;
+	enc->queue = NULL;
+	enc->srv_link = NULL;
+	enc->ccu_link = NULL;
+
+	/* 1. Hardware/PM allocation. */
+	if (test_and_clear_bit(RKVENC_STAGE_HW, &enc->probe_stages))
+		rkvenc_hw_remove(enc);
+}
+
 /* ---- Core probe ---- */
 static int rkvenc_core_probe(struct platform_device *pdev)
 {
@@ -322,19 +518,20 @@ static int rkvenc_core_probe(struct platform_device *pdev)
 	ret = rkvenc_hw_probe(enc, pdev);
 	if (ret)
 		return ret;
+	set_bit(RKVENC_STAGE_HW, &enc->probe_stages);
 
 	/* Attach to service */
 	ret = rkvenc_attach_service(enc);
 	if (ret) {
 		dev_err_probe(dev, ret, "failed to attach service\n");
-		goto err_hw;
+		goto err_unwind;
 	}
 
 	/* Attach core to CCU */
 	ret = rkvenc_attach_ccu(dev, enc);
 	if (ret) {
 		dev_err_probe(dev, ret, "attach ccu failed\n");
-		goto err_hw;
+		goto err_unwind;
 	}
 
 	/*
@@ -351,8 +548,12 @@ static int rkvenc_core_probe(struct platform_device *pdev)
 		enc->sram_enabled = -1;
 		dev_info(dev, "sram inherited from main core: iova %pad size %u used %u\n",
 			 &enc->sram_iova, enc->sram_size, enc->sram_used);
-	} else {
-		rkvenc2_alloc_rcbbuf(pdev, enc);
+	} else if (!rkvenc2_alloc_rcbbuf(pdev, enc)) {
+		/* SRAM is optional, so a failure is not fatal -- but a SUCCESS
+		 * creates an IOMMU mapping and possibly a page allocation that
+		 * the unwind now owns.
+		 */
+		set_bit(RKVENC_STAGE_SRAM_MAPPED, &enc->probe_stages);
 	}
 
 	/* Register IRQ */
@@ -365,21 +566,28 @@ static int rkvenc_core_probe(struct platform_device *pdev)
 	}
 	if (ret) {
 		dev_err(dev, "register interrupt failed: %d\n", ret);
-		goto err_hw;
+		goto err_unwind;
 	}
+	set_bit(RKVENC_STAGE_IRQ_REQUESTED, &enc->probe_stages);
 
-	/* If this is the main core, register with the service */
+	/* LAST, and deliberately so: publishing the core to the service is what
+	 * makes it reachable from userspace, so nothing may be published until
+	 * every earlier stage has actually succeeded.
+	 */
 	if (enc->ccu && enc == enc->ccu->main_core) {
+		mutex_lock(&enc->srv->session_lock);
 		enc->srv->sub_devices[MPP_DEVICE_RKVENC] = enc;
 		set_bit(MPP_DEVICE_RKVENC, &enc->srv->hw_support);
+		mutex_unlock(&enc->srv->session_lock);
+		set_bit(RKVENC_STAGE_SERVICE_PUBLISHED, &enc->probe_stages);
 	}
 
 	dev_info(dev, "rkvenc core %d probe success (hw_id: %08x)\n",
 		 enc->core_id, enc->hw_info->hw.hw_id);
 	return 0;
 
-err_hw:
-	rkvenc_hw_remove(enc);
+err_unwind:
+	rkvenc_core_unwind(enc);
 	return ret;
 }
 
@@ -391,28 +599,8 @@ static int rkvenc_core_remove(struct platform_device *pdev)
 	if (!enc)
 		return 0;
 
-	if (enc->ccu) {
-		mutex_lock(&enc->ccu->lock);
-		list_del_init(&enc->core_link);
-		enc->ccu->core_num--;
-		mutex_unlock(&enc->ccu->lock);
-	}
-
-	/* Free SRAM — only the core that mapped it (main or standalone) */
-	if (enc->sram_iova && enc->iommu_info && enc->iommu_info->domain &&
-	    (!enc->ccu || enc == enc->ccu->main_core)) {
-		struct iommu_domain *domain = enc->iommu_info->domain;
-
-		if (enc->rcb_page) {
-			size_t page_size = PAGE_ALIGN(enc->sram_used - enc->sram_size);
-
-			iommu_unmap(domain, enc->sram_iova + enc->sram_size, page_size);
-			__free_pages(enc->rcb_page, get_order(page_size));
-		}
-		iommu_unmap(domain, enc->sram_iova, enc->sram_size);
-	}
-
-	rkvenc_hw_remove(enc);
+	/* The SAME ledger the probe error path walks. */
+	rkvenc_core_unwind(enc);
 	dev_info(&pdev->dev, "rkvenc core removed\n");
 	return 0;
 }
@@ -468,6 +656,7 @@ static void rkvenc_shutdown(struct platform_device *pdev)
 
 	dev_info(dev, "shutdown device\n");
 	atomic_inc(&enc->srv->shutdown_request);
+	rkvenc_service_quiesce(enc->srv);
 
 	ret = readx_poll_timeout(atomic_read, &enc->task_count,
 				 val, val == 0, 20000, 200000);
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc_hw.h b/drivers/media/platform/rockchip/rkvenc/rkvenc_hw.h
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc_hw.h
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc_hw.h
@@ -414,6 +414,28 @@ struct rkvenc_grf_info {
 	u32 val;
 };
 
+/*
+ * Service lifetime.
+ *
+ * LIVE      normal operation.
+ * QUIESCING teardown has begun: new opens and new submissions are refused,
+ *           queued and in-flight work is being cancelled and every waiter is
+ *           being woken with -ENODEV. Existing file descriptors stay VALID --
+ *           userspace still has to close them, and until it does the service
+ *           must not release anything they can reach.
+ * DEAD      every open file has passed through release. Only now may
+ *           supplier-owned state be torn down.
+ *
+ * Guarded by the EXISTING session_lock rather than a new lock of its own: that
+ * lock already serialises the session list this state decides the fate of, and
+ * a second lock over the same data is how an ordering cycle gets introduced.
+ */
+enum rkvenc_service_state {
+	RKVENC_SRV_LIVE = 0,
+	RKVENC_SRV_QUIESCING,
+	RKVENC_SRV_DEAD,
+};
+
 /* ---- MPP service ---- */
 struct rkvenc_service {
 	struct device *dev;
@@ -433,11 +455,17 @@ struct rkvenc_service {
 
 	struct mutex session_lock;
 	struct list_head session_list;
+	enum rkvenc_service_state state;
+	u32 session_count;
+	wait_queue_head_t quiesce_wait;
 
 	u32 timing_en;
 	atomic_t shutdown_request;
 };
 
+bool rkvenc_service_is_live(struct rkvenc_service *srv);
+void rkvenc_service_quiesce(struct rkvenc_service *srv);
+
 /* ---- MPP task ---- */
 struct rkvenc_mpp_task {
 	struct list_head pending_link;
@@ -604,8 +632,21 @@ struct rkvenc_session {
 	/* Session private data */
 	void *priv;
 
+	/*
+	 * Lifetime. The file descriptor holds one reference and every task
+	 * holds one more, so a session outlives its FD for exactly as long as
+	 * some task still points at it. Without this the release path's bounded
+	 * drain could time out and free a session the worker was about to
+	 * dereference through task->session -- which is a use-after-free that
+	 * only ever fires when a task is slow, i.e. under load.
+	 */
+	struct kref ref;
 };
 
+void rkvenc_session_get(struct rkvenc_session *session);
+void rkvenc_session_put(struct rkvenc_session *session);
+void rkvenc_session_abort(struct rkvenc_session *session);
+
 /* ---- Task messages ---- */
 struct rkvenc_task_msgs {
 	struct list_head list;
@@ -721,6 +762,18 @@ struct rkvenc_dev {
 	struct reset_control *rst_h;
 	struct reset_control *rst_core;
 
+	/*
+	 * Probe stage ledger. Each bit records a step that COMPLETED, so the
+	 * unwind is the exact inverse of what actually happened rather than of
+	 * what the happy path would have done. It is the same ledger on probe
+	 * failure and on remove, which is what stops the two drifting apart --
+	 * historically the probe error path unwound one of the six steps it had
+	 * taken, and remove unwound a different two.
+	 */
+	unsigned long probe_stages;
+	struct device_link *srv_link;
+	struct device_link *ccu_link;
+
 	/* Multi-core */
 	struct rkvenc_ccu *ccu;
 	struct list_head core_link;
@@ -749,6 +802,16 @@ struct rkvenc_dev {
 	u32 disable;
 };
 
+/* Probe stages, in ACQUISITION order. The unwind walks them in reverse. */
+#define RKVENC_STAGE_HW			0
+#define RKVENC_STAGE_SERVICE_ATTACHED	1
+#define RKVENC_STAGE_QUEUE_PUBLISHED	2
+#define RKVENC_STAGE_CCU_ATTACHED	3
+#define RKVENC_STAGE_IOMMU_SHARED	4
+#define RKVENC_STAGE_SRAM_MAPPED	5
+#define RKVENC_STAGE_IRQ_REQUESTED	6
+#define RKVENC_STAGE_SERVICE_PUBLISHED	7
+
 /* ---- Helper macros ---- */
 static inline u32 rkvenc_read(struct rkvenc_dev *mpp, u32 reg)
 {
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc_service.c b/drivers/media/platform/rockchip/rkvenc/rkvenc_service.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc_service.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc_service.c
@@ -50,14 +50,15 @@ static struct rkvenc_session *rkvenc_session_init(void)
 	INIT_LIST_HEAD(&session->session_link);
 	atomic_set(&session->task_count, 0);
 	atomic_set(&session->release_request, 0);
+	kref_init(&session->ref);
 
 	return session;
 }
 
-static void rkvenc_session_deinit(struct rkvenc_session *session)
+static void rkvenc_session_release(struct kref *ref)
