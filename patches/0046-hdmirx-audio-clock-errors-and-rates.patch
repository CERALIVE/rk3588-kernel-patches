From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andres Cera <andres.cera@hotmail.com>
Date: Sat, 5 Sep 2026 14:00:00 +0000
Subject: [PATCH 46/49] media: synopsys: hdmirx: propagate audio clock errors and validate LPCM rates

Keep recorded rates unchanged on clock failure; refuse unsupported HBR rates.
Reconciliation evidence: docs/UPSTREAM-STATUS.md.
Code-only qualification; no new board evidence is claimed.

First-party: authored by CeraLive against v7.2, with no upstream
counterpart in rockchip-rk3588-mainline-patches. The source of record
is ceralive/0046-hdmirx-audio-clock-errors-and-rates.patch
and patches/ is generated from it by scripts/build-series.py.
scripts/verify-payload-parity.py holds it to the same
added/removed-line parity the upstream lane gets.

NOT upstream-bound: this targets the CeraLive device tree only and
is not a submission to linux-media, linux-rockchip or the fork
parent. No Signed-off-by is added, because a DCO assertion belongs
to whoever actually submits it.

---
diff --git a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
index e84be6371..904a16b10 100644
--- a/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
+++ b/drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c
@@ -2880,7 +2880,7 @@ static void hdmirx_enable_irq(struct device *dev)
 			   msecs_to_jiffies(110));
 }
 
-static void hdmirx_audio_setup(struct snps_hdmirx_dev *hdmirx_dev, u32 fs);
+static int hdmirx_audio_setup(struct snps_hdmirx_dev *hdmirx_dev, u32 fs);
 
 static __maybe_unused int hdmirx_suspend(struct device *dev)
 {
@@ -2923,7 +2923,9 @@ static __maybe_unused int hdmirx_resume(struct device *dev)
 	 * resynchronize once the source delivers audio again.
 	 */
 	if (READ_ONCE(hdmirx_dev->audio_streaming)) {
-		hdmirx_audio_setup(hdmirx_dev, hdmirx_dev->audio_fs);
+		ret = hdmirx_audio_setup(hdmirx_dev, hdmirx_dev->audio_fs);
+		if (ret)
+			return ret;
 		mod_delayed_work(system_unbound_wq, &hdmirx_dev->audio_work,
 				 msecs_to_jiffies(200));
 	}
@@ -3029,7 +3031,7 @@ static int hdmirx_register_cec(struct snps_hdmirx_dev *hdmirx_dev,
 #define HDMIRX_AUDIO_INIT_STATE		(HDMIRX_AUDIO_INIT_FIFO_STATE * 4)
 
 static const int hdmirx_supported_fs[] = {
-	32000, 44100, 48000, 88200, 96000, 176400, 192000, 768000, -1
+	32000, 44100, 48000, 88200, 96000, 176400, 192000, -1
 };
 
 static int hdmirx_audio_closest_fs(int fs)
@@ -3077,7 +3079,7 @@ static u32 hdmirx_audio_fs(struct snps_hdmirx_dev *hdmirx_dev)
 /* Nudge the audio reference clock by +/- ppm to keep the FIFO balanced. */
 static void hdmirx_audio_clk_ppm_inc(struct snps_hdmirx_dev *hdmirx_dev, int ppm)
 {
-	int delta, inc;
+	int delta, inc, ret;
 	long rate = hdmirx_dev->audio_clkrate;
 
 	if (ppm < 0) {
@@ -3089,10 +3091,34 @@ static void hdmirx_audio_clk_ppm_inc(struct snps_hdmirx_dev *hdmirx_dev, int ppm
 	delta = (int)div64_u64((u64)rate * ppm + 500000, 1000000);
 	delta *= inc;
 	rate = hdmirx_dev->audio_clkrate + delta;
-	clk_set_rate(hdmirx_dev->audio_clk, rate);
+	ret = clk_set_rate(hdmirx_dev->audio_clk, rate);
+	if (ret) {
+		dev_warn_ratelimited(hdmirx_dev->dev,
+				     "audio clock correction refused: %d\n", ret);
+		return;
+	}
 	hdmirx_dev->audio_clkrate = rate;
 }
 
+static int hdmirx_audio_set_fs(struct snps_hdmirx_dev *hdmirx_dev, u32 fs)
+{
+	int ret;
+
+	/* This LPCM path does not implement HBR's 768 kHz transport rate. */
+	if (!fs || fs > 192000 || hdmirx_audio_closest_fs(fs) != (int)fs)
+		return -EINVAL;
+
+	ret = clk_set_rate(hdmirx_dev->audio_clk, fs * 128);
+	if (ret) {
+		dev_err_ratelimited(hdmirx_dev->dev,
+				    "audio clock for %u Hz refused: %d\n", fs, ret);
+		return ret;
+	}
+	hdmirx_dev->audio_clkrate = fs * 128;
+	hdmirx_dev->audio_fs = fs;
+	return 0;
+}
+
 static int hdmirx_audio_clk_adjust(struct snps_hdmirx_dev *hdmirx_dev,
 				   int total_offset, int single_offset)
 {
@@ -3133,11 +3159,12 @@ static void hdmirx_audio_fifo_reinit(struct snps_hdmirx_dev *hdmirx_dev)
  * sample rate. Shared by hw_params and system resume: the controller is
  * fully reset on resume, so the whole configuration must be re-applied.
  */
-static void hdmirx_audio_setup(struct snps_hdmirx_dev *hdmirx_dev, u32 fs)
+static int hdmirx_audio_setup(struct snps_hdmirx_dev *hdmirx_dev, u32 fs)
 {
-	hdmirx_dev->audio_fs = fs;
-	hdmirx_dev->audio_clkrate = fs * 128;
-	clk_set_rate(hdmirx_dev->audio_clk, hdmirx_dev->audio_clkrate);
+	int ret = hdmirx_audio_set_fs(hdmirx_dev, fs);
+
+	if (ret)
+		return ret;
 
 	hdmirx_audio_fifo_reinit(hdmirx_dev);
 	hdmirx_writel(hdmirx_dev, AUDIO_FIFO_THR_PASS, HDMIRX_AUDIO_INIT_FIFO_STATE);
@@ -3150,6 +3177,7 @@ static void hdmirx_audio_setup(struct snps_hdmirx_dev *hdmirx_dev, u32 fs)
 	hdmirx_update_bits(hdmirx_dev, GLOBAL_SWENABLE, AUDIO_ENABLE, AUDIO_ENABLE);
 
 	hdmirx_dev->audio_pre_state = 0;
+	return 0;
 }
 
 /*
@@ -3168,11 +3196,8 @@ static void hdmirx_audio_work(struct work_struct *work)
 	fifo = hdmirx_readl(hdmirx_dev, AUDIO_FIFO_STATUS2);
 
 	if (fifo & (AFIFO_UNDERFLOW_ST | AFIFO_OVERFLOW_ST)) {
-		if (fs) {
-			clk_set_rate(hdmirx_dev->audio_clk, fs * 128);
-			hdmirx_dev->audio_clkrate = fs * 128;
-			hdmirx_dev->audio_fs = fs;
-		}
+		if (fs && hdmirx_audio_set_fs(hdmirx_dev, fs))
+			goto out;
 		hdmirx_audio_fifo_reinit(hdmirx_dev);
 		hdmirx_dev->audio_pre_state = 0;
 		goto out;
@@ -3183,9 +3208,8 @@ static void hdmirx_audio_work(struct work_struct *work)
 	single = cur - hdmirx_dev->audio_pre_state;
 
 	if (fs && abs((int)fs - (int)hdmirx_dev->audio_fs) > 1000) {
-		clk_set_rate(hdmirx_dev->audio_clk, fs * 128);
-		hdmirx_dev->audio_clkrate = fs * 128;
-		hdmirx_dev->audio_fs = fs;
+		if (hdmirx_audio_set_fs(hdmirx_dev, fs))
+			goto out;
 		hdmirx_audio_fifo_reinit(hdmirx_dev);
 		hdmirx_dev->audio_pre_state = 0;
 		goto out;
@@ -3210,6 +3234,7 @@ static int hdmirx_audio_hw_params(struct device *dev, void *data,
 {
 	struct snps_hdmirx_dev *hdmirx_dev = dev_get_drvdata(dev);
 	u32 fs;
+	int ret;
 
 	/* Only the I2S interface (DAI 0) is wired up so far. */
 	if (fmt->fmt == HDMI_SPDIF)
@@ -3228,7 +3253,9 @@ static int hdmirx_audio_hw_params(struct device *dev, void *data,
 	if (!fs)
 		fs = 48000;
 
-	hdmirx_audio_setup(hdmirx_dev, fs);
+	ret = hdmirx_audio_setup(hdmirx_dev, fs);
+	if (ret)
+		return ret;
 
 	WRITE_ONCE(hdmirx_dev->audio_streaming, true);
 	mod_delayed_work(system_unbound_wq, &hdmirx_dev->audio_work,
