# rebase/v7.1.5.rules — context re-anchors for KERNEL_TAG=v7.1.5
#
# WHAT THIS FILE IS ALLOWED TO DO
# ------------------------------
# Upstream authored these patches against v6.19-rc8 (see upstream/README.MD). We
# apply them to v7.1.5. In between, mainline moved some CONTEXT lines the patches
# rely on as anchors. A rule here edits ONLY context lines (' '-prefixed) so a hunk
# can find its home again.
#
# It is STRUCTURALLY INCAPABLE of changing behaviour:
#   * `replace` and `insert-before` refuse to touch a '+' or '-' line — the tool
#     raises if the matched line is not a context line.
#   * scripts/build-series.py recomputes the affected @@ counts so the hunk stays
#     well-formed.
#   * scripts/verify-payload-parity.py then proves, byte for byte, that the set of
#     '+' and '-' lines in patches/ is IDENTICAL to upstream/. If a rule ever
#     changed what a patch does, that check fails.
#
# WHAT IT IS NOT ALLOWED TO DO
# ----------------------------
# Anything requiring a judgement about what the driver should DO. If a hunk cannot
# be re-anchored by context alone, it does NOT get a rule — it gets an entry in
# docs/REBASE-v7.1.5.md under "stopped", and the series is reported as not applying.
# See that document for the full hunk-by-hunk ledger, including the one placement
# decision (R2) that was made and why it is behaviour-neutral.
#
# FORMAT
#   <patch-file>|<op>|<anchor-line>|<payload-line>
#
#   op=replace         anchor is an existing context line; it becomes payload.
#                      Hunk counts unchanged.
#   op=insert-before   payload becomes a NEW context line immediately before the
#                      first matching context line `anchor`. Hunk old/new counts
#                      each +1.
#
#   Literal '\t' in a field is a TAB (kernel source is tab-indented).
#   The anchor must match exactly once within the target patch; ambiguity is fatal.

# --- R1 -------------------------------------------------------------------
# 0001, arch/arm64/boot/dts/rockchip/rk3588-base.dtsi, hunk @@ -1351,6 +1353,92 @@
#
# The hunk inserts the mpp-service / rkvenc0 / rkvenc1 nodes just before `av1d`.
# Its leading anchor is the tail of the NEIGHBOURING `vdec1_mmu` node, which the
# patch never modifies. Mainline re-pointed that node's power domain from the
# shared VDPU domain to its own RKVDEC1 domain, so the anchor text drifted.
#
# Nothing the patch adds references RK3588_PD_VDPU. Confirmed at v7.1.5:
# RK3588_PD_VENC0/VENC1, ACLK/HCLK/CLK_RKVENC{0,1}_CORE and SRST_{A,H}_RKVENC{0,1}
# all still exist, and neither `rkvenc0:`/`rkvenc1:` nor
# drivers/media/platform/rockchip/rkvenc/ exists upstream — so this is anchor
# drift on a neighbour, not a collision with the encoder work.
0001-rockchip-rk3588-vepu580-encoder-support-v3.patch|replace|\t\tpower-domains = <&power RK3588_PD_VDPU>;|\t\tpower-domains = <&power RK3588_PD_RKVDEC1>;

# --- R2 -------------------------------------------------------------------
# 0005, drivers/media/platform/synopsys/hdmirx/snps_hdmirx.c, hunk @@ -135,7 +148,13 @@
#
# The hunk adds audio members to `struct snps_hdmirx_dev`, anchored between
# `cec` and `stream_lock`. Mainline added `phy_rw_lock` in exactly that gap, so
# the anchor no longer matches. Re-adding it as context restores the match.
#
# This is the ONE placement decision in this file: the new members stay where the
# patch put them (immediately after `cec`), and `phy_rw_lock` follows them. The
# alternative ordering is equivalent — `struct snps_hdmirx_dev` is a private
# driver struct: not UAPI, not packed, never serialised, and no member is reached
# by offset. Member order therefore has no observable effect. Ledgered in
# docs/REBASE-v7.1.5.md §R2.
0005-rockchip-rk3588-hdmirx-audio.patch|insert-before|\tstruct mutex stream_lock; /* to lock video stream capture */|\tstruct mutex phy_rw_lock; /* to protect phy r/w configuration */
