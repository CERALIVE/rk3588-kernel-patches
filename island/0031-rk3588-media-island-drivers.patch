+#ifdef CONFIG_ROCKCHIP_MPP_PROC_FS
+static int vdpu_procfs_remove(struct mpp_dev *mpp)
+{
+	struct vdpu_dev *dec = to_vdpu_dev(mpp);
+
+	if (dec->procfs) {
+		proc_remove(dec->procfs);
+		dec->procfs = NULL;
