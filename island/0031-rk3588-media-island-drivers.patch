+static int vdpu_clk_on(struct mpp_dev *mpp)
+{
+	struct vdpu_dev *dec = to_vdpu_dev(mpp);
+
+	mpp_clk_safe_enable(dec->aclk_info.clk);
+	mpp_clk_safe_enable(dec->hclk_info.clk);
+
+	return 0;
+}
