+	mpp_procfs_create_u32("aclk", 0644,
+			      iep->procfs, &iep->aclk_info.debug_rate_hz);
+	mpp_procfs_create_u32("session_buffers", 0644,
+			      iep->procfs, &mpp->session_max_buffers);
+
+	return 0;
+}
