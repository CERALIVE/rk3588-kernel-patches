+#ifdef CONFIG_ROCKCHIP_MPP_PROC_FS
+static int iep2_procfs_remove(struct mpp_dev *mpp)
+{
+	struct iep2_dev *iep = to_iep2_dev(mpp);
+
+	if (iep->procfs) {
+		proc_remove(iep->procfs);
+		iep->procfs = NULL;
+	}
