+static int vdpu_clk_off(struct mpp_dev *mpp)
+{
+	struct vdpu_dev *dec = to_vdpu_dev(mpp);
+
+	mpp_clk_safe_disable(dec->aclk_info.clk);
+	mpp_clk_safe_disable(dec->hclk_info.clk);
+
+	return 0;
+}
