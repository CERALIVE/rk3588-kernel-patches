+
+/* RGA3_MMU_STATUS read_only */
+#define m_RGA3_MMU_STATUS_PAGING_ENABLED			(0x1 << 0)
+#define m_RGA3_MMU_STATUS_PAGE_FAULT_ACTIVE			(0x1 << 1)
