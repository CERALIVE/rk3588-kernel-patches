+		u_ld_addr = 0;
+		u_rt_addr = 0;
+		u_rd_addr = 0;
+
+		v_lt_addr = 0;
+		v_ld_addr = 0;
+		v_rt_addr = 0;
+		v_rd_addr = 0;
+
