+		y_mirr = 0;
+	} else {
+		x_mirr = 1;
+		y_mirr = 1;
+	}
+
+	rot_90_flag = msg->rotate_mode & 1;
+	x_mirr = (x_mirr + ((msg->rotate_mode >> 4) & 1)) & 1;
+	y_mirr = (y_mirr + ((msg->rotate_mode >> 5) & 1)) & 1;
