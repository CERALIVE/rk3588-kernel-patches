+		dpw = 2;
+		dst_alpha_swp = 1;
+		break;
+	case RGA_FORMAT_ABGR_5551:
+		dst_format = 0x5;
+		dpw = 2;
+		dst_alpha_swp = 1;
+		dst_rb_swp = 0x1;
+		break;
+	case RGA_FORMAT_ARGB_4444:
+		dst_format = 0x6;
+		dpw = 2;
+		dst_alpha_swp = 1;
+		break;
+	case RGA_FORMAT_ABGR_4444:
+		dst_format = 0x6;
