+
+#ifndef _RGA_DEBUGGER_H_
+#define _RGA_DEBUGGER_H_
+
+#include "rga_drv.h"
+
+#ifdef CONFIG_ROCKCHIP_RGA_DEBUGGER
+
+extern int RGA_DEBUG_REG;
