+static int av1dec_procfs_init(struct mpp_dev *mpp)
+{
+	struct av1dec_dev *dec = to_av1dec_dev(mpp);
+
+	dec->procfs = proc_mkdir(mpp->dev->of_node->name, mpp->srv->procfs);
+	if (IS_ERR_OR_NULL(dec->procfs)) {
