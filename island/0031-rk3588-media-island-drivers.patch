+		plane_width = 2;
+		x_div = 2;
+		y_div = 2;
+		break;
+	case RGA_FORMAT_YCbCr_420_P:
+		dst_format = 0xb;
+		dst_cbcr_swp = 1;
+		plane_width = 1;
+		x_div = 2;
+		y_div = 2;
+		break;
+	case RGA_FORMAT_YCrCb_422_SP:
+		dst_format = 0x8;
+		dst_cbcr_swp = 1;
+		plane_width = 2;
+		x_div = 2;
+		y_div = 1;
+		break;
+	case RGA_FORMAT_YCrCb_422_P:
+		dst_format = 0x9;
+		dst_cbcr_swp = 1;
+		plane_width = 1;
+		x_div = 2;
+		y_div = 1;
+		break;
+	case RGA_FORMAT_YCrCb_420_SP:
+		dst_format = 0xa;
+		dst_cbcr_swp = 1;
+		plane_width = 2;
+		x_div = 2;
+		y_div = 2;
+		break;
+	case RGA_FORMAT_YCrCb_420_P:
+		dst_format = 0xb;
+		plane_width = 1;
+		x_div = 2;
+		y_div = 2;
+		break;
+
+	case RGA_FORMAT_YCbCr_400:
