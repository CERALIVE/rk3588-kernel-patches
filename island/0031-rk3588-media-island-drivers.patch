+
+#include "rga_drv.h"
+
+enum rga_mmu {
+	RGA_NONE_MMU	= 0,
+	RGA_MMU		= 1,
+	RGA_IOMMU	= 2,
+};
+
+enum rga_hw_support_format_index {
+	RGA_RASTER_INDEX,
+	RGA_AFBC16x16_INDEX,
+	RGA_TILE8x8_INDEX,
+	RGA_TILE4x4_INDEX,
+	RGA_RKFBC64x4_INDEX,
+	RGA_AFBC32x8_INDEX,
+	RGA_FORMAT_INDEX_BUTT,
+};
