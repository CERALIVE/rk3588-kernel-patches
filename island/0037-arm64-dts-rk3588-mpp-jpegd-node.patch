From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CeraLive <dev@ceralive.tv>
Date: Wed, 2 Sep 2026 00:00:00 +0000
Subject: [PATCH 7/9] arm64: dts: rockchip: add the RK3588 MPP JPEG decoder

Add the donor-only JPEG decoder client and its mainline Rockchip IOMMU node.
The compatible is read directly from the imported mpp_jpgdec match table, and
the client skips the unavailable BSP PMU idle-request path.

Origin: rockchip-linux/kernel@b4ef083dc0c3608e744deabb43dc6b781aadbe6e:arch/arm64/boot/dts/rockchip/rk3588s.dtsi
Reference: armbian/linux-rockchip@fd9f82366e235b8afbdf516765210e97d24dce93:arch/arm64/boot/dts/rockchip/rk3588s.dtsi

Patches a file mainline already carries. The payload below is carried byte-for-byte from integration/0012-arm64-dts-rk3588-mpp-jpegd-node.patch; scripts/build-series.py adds the mail header and nothing else, and scripts/verify-series-parity.py proves that independently.

---
diff --git a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3588-base.dtsi
@@ -1489,6 +1489,38 @@
 		power-domains = <&power RK3588_PD_RKVDEC1>;
 		#iommu-cells = <0>;
 	};
+
+	jpegd: jpegd@fdb90000 {
+		compatible = "rockchip,rkv-jpeg-decoder-v1";
+		reg = <0x0 0xfdb90000 0x0 0x400>;
+		interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH 0>;
+		interrupt-names = "irq_jpegd";
+		clocks = <&cru ACLK_JPEG_DECODER>, <&cru HCLK_JPEG_DECODER>;
+		clock-names = "aclk_vcodec", "hclk_vcodec";
+		rockchip,normal-rates = <600000000>, <0>;
+		assigned-clocks = <&cru ACLK_JPEG_DECODER>;
+		assigned-clock-rates = <600000000>;
+		resets = <&cru SRST_A_JPEG_DECODER>, <&cru SRST_H_JPEG_DECODER>;
+		reset-names = "video_a", "video_h";
+		rockchip,skip-pmu-idle-request;
+		iommus = <&jpegd_mmu>;
+		rockchip,srv = <&mpp_srv>;
+		rockchip,taskqueue-node = <1>;
+		power-domains = <&power RK3588_PD_VDPU>;
+		status = "okay";
+	};
+
+	jpegd_mmu: iommu@fdb90480 {
+		compatible = "rockchip,rk3588-iommu", "rockchip,rk3568-iommu";
+		reg = <0x0 0xfdb90480 0x0 0x40>;
+		interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH 0>;
+		interrupt-names = "irq_jpegd_mmu";
+		clocks = <&cru ACLK_JPEG_DECODER>, <&cru HCLK_JPEG_DECODER>;
+		clock-names = "aclk", "iface";
+		power-domains = <&power RK3588_PD_VDPU>;
+		#iommu-cells = <0>;
+		status = "okay";
+	};
 
 	mpp_srv: mpp-srv {
 		compatible = "rockchip,mpp-service";
-- 
